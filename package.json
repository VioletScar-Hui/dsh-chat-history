{
  "name": "@violet/dsh-chat-history",
  "version": "1.1.0",
  "description": "给 DSH 聊天输入框加上 CLI 风格的历史记忆：按上下方向键召回之前发送过的内容（纯客户端插件，重启不丢）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.1.0-rc.6"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "bun scripts/build.js",
    "prepare": "bun scripts/build.js",
    "test": "bun test"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "chat",
    "history",
    "cli",
    "input",
    "历史记录"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VioletScar-Hui/dsh-chat-history.git"
  },
  "bugs": {
    "url": "https://github.com/VioletScar-Hui/dsh-chat-history/issues"
  },
  "homepage": "https://github.com/VioletScar-Hui/dsh-chat-history#readme",
  "peerDependencies": {
    "react": "^18.2.0"
  }
}
